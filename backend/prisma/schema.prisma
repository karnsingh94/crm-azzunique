  notes                String?            @db.Text
  metadata             Json?
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  clientAdmin          ClientAdmin        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer             CrmCustomer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrder           SalesOrder?        @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  items                SalesInvoiceItem[]

  @@unique([companyId, invoiceNo])
  @@index([companyId, status, invoiceDate])
  @@index([companyId, customerId])
  @@index([companyId, dispatchOrderId])
  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id                   String             @id @default(uuid()) @db.Char(36)
  companyId            String             @map("company_id") @db.Char(36)
  invoiceId            String             @map("invoice_id") @db.Char(36)
  productId            String?            @map("product_id") @db.Char(36)
  dispatchOrderItemId  String?            @map("dispatch_order_item_id") @db.Char(36)
  sku                  String             @db.VarChar(80)
  description          String?            @db.VarChar(255)
  hsnCode              String?            @map("hsn_code") @db.VarChar(20)
  uom                  String             @default("PCS") @db.VarChar(20)
  quantity             Decimal            @db.Decimal(15, 3)
  unitPrice            Decimal            @map("unit_price") @db.Decimal(15, 2)
  discountRate         Decimal            @default(0) @map("discount_rate") @db.Decimal(5, 2)
  discountAmount       Decimal            @default(0) @map("discount_amount") @db.Decimal(15, 2)
  taxableAmount        Decimal            @map("taxable_amount") @db.Decimal(15, 2)
  taxRate              Decimal            @default(0) @map("tax_rate") @db.Decimal(5, 2)
  cgstAmount           Decimal            @default(0) @map("cgst_amount") @db.Decimal(15, 2)
  sgstAmount           Decimal            @default(0) @map("sgst_amount") @db.Decimal(15, 2)
  igstAmount           Decimal            @default(0) @map("igst_amount") @db.Decimal(15, 2)
  totalAmount          Decimal            @map("total_amount") @db.Decimal(15, 2)

  clientAdmin          ClientAdmin        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice              SalesInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product              Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([companyId, invoiceId])
  @@index([companyId, productId])
  @@map("sales_invoice_items")
}

model SubscriptionPlan {
  id              String        @id @default(uuid()) @db.Char(36)
  name            String        @db.VarChar(150)
  description     String?       @db.Text
  billingCycle    String        @map("billing_cycle") @db.VarChar(30) // MONTHLY | HALF_YEARLY | ANNUAL
  price           Decimal       @default(0.00) @db.Decimal(12, 2)
  currency        String        @default("INR") @db.VarChar(10)

  // Tenant Quotas & Limits (null = unlimited)
  maxLeads        Int?          @map("max_leads")
  maxEmployees    Int?          @map("max_employees")
  maxLeadSources  Int?          @map("max_lead_sources")
  maxCustomers    Int?          @map("max_customers")
  maxSalesOrders  Int?          @map("max_sales_orders")
  maxProducts     Int?          @map("max_products")

  // Feature & Lead Channel Permissions
  canUseWebhook   Boolean       @default(true) @map("can_use_webhook")
  canUseIndiamart Boolean       @default(false) @map("can_use_indiamart")
  canUseMeta      Boolean       @default(false) @map("can_use_meta")
  canUseEmail     Boolean       @default(false) @map("can_use_email")
  canUseJustdial  Boolean       @default(false) @map("can_use_justdial")
  canUseSalesFlow Boolean       @default(true) @map("can_use_sales_flow")
  canUseInventory Boolean       @default(true) @map("can_use_inventory")
  canUseReports   Boolean       @default(true) @map("can_use_reports")
  canUseAuditLog  Boolean       @default(true) @map("can_use_audit_log")

  isActive        Boolean       @default(true) @map("is_active")
  isPopular       Boolean       @default(false) @map("is_popular")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  companies       ClientAdmin[]

  @@unique([name, billingCycle])
  @@map("subscription_plans")
}
