# ==============================================================================
# AZZUNIQUE CRM & Sales — Backend Environment Configuration Template
# Copy this file to .env and supply environment-specific credentials.
# NEVER commit the real .env file into version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Server Logging Level (error, warn, info, debug)
LOG_LEVEL=info

# MySQL Database Connection String (Prisma format)
# Format: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL="mysql://root:your_mysql_password@localhost:3306/crm_azzunique_db"

# Optional initial platform Super Admin credentials for `npm run seed`.
# Defaults match the development bootstrap account if these are not set.
# SUPER_ADMIN_NAME="Platform Super Admin"
# SUPER_ADMIN_EMAIL="admin@azzunique.com"
# SUPER_ADMIN_PASSWORD="choose-a-strong-password"

# Primary Frontend Client URL (for CORS and Reset Links)
CLIENT_URL="http://localhost:3000"

# Optional comma-separated additional origins for CORS (e.g. production domain, staging)
# ADDITIONAL_CORS_ORIGINS="https://admin.azzunique.com,https://company.azzunique.com"

# Mail Delivery Service Configuration (SMTP; required to send password reset emails)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
# Set true when using implicit TLS (usually port 465); false for STARTTLS (usually port 587).
SMTP_SECURE=false
SMTP_USER="no-reply@azzunique.com"
SMTP_PASS="your_smtp_password"
SMTP_FROM="AZZUNIQUE Security <no-reply@azzunique.com>"
